# --- Required secrets --------------------------------------------------
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# --- LLM behaviour -------------------------------------------------------
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Search / scrape behaviour --------------------------------------------
SEARCH_MAX_RESULTS=5
SCRAPE_MAX_URLS=3
SCRAPE_TIMEOUT_SECONDS=15
SCRAPE_MAX_CHARS=5000
HTTP_MAX_RETRIES=3

# --- Caching / rate limiting -----------------------------------------------
CACHE_TTL_SECONDS=3600
RATE_LIMIT_CALLS_PER_MINUTE=30

# --- Ops ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
ENVIRONMENT=development
